+/// A CSS-style cubic bezier timing curve: control points (x1, y1) and (x2, y2).
+#[derive(Clone, Copy, Debug)]
+struct Curve(f64, f64, f64, f64);
+
+/// Hyprland's popular `bezier = myBezier, 0.05, 0.9, 0.1, 1.05` for window moves: a fast
+/// start, a slight overshoot past the target and a soft settle back onto it.
+const OVERSHOOT: Curve = Curve(0.05, 0.9, 0.1, 1.05);
+/// Hyprland's built-in `default` curve, which it uses for workspace slides: fast start, no
+/// overshoot, so a whole screen of windows never sails past its place and snaps back.
+const SMOOTH: Curve = Curve(0.0, 0.75, 0.15, 1.0);
+
+impl Curve {
+    fn at(self, t: f64) -> f64 {
+        let Curve(x1, y1, x2, y2) = self;
+        let bezier = |p1: f64, p2: f64, u: f64| {
+            3.0 * (1.0 - u) * (1.0 - u) * u * p1 + 3.0 * (1.0 - u) * u * u * p2 + u * u * u
+        };
+        if t <= 0.0 || t >= 1.0 {
+            return t.clamp(0.0, 1.0); // exact endpoints, so a finished animation lands on its target
+        }
+        // x(u) is monotonic for these control points, so bisection finds u for time t.
+        let (mut lo, mut hi) = (0.0, 1.0);
+        for _ in 0..32 {
+            let mid = (lo + hi) / 2.0;
+            if bezier(x1, x2, mid) < t {
+                lo = mid
+            } else {
+                hi = mid
+            }
+        }
+        bezier(y1, y2, (lo + hi) / 2.0)
     }
