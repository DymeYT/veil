<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Default (SIP-off safe): library-validation bypass only.
	  Private MediaRemote entitlement is NOT claimed by default — AMFI SIGKILLs
	  ad-hoc binaries that assert com.apple.private.mediaremote.read-write even
	  when csrutil is disabled, unless amfi_get_out_of_my_way is set.
	  Under SIP-off, MediaRemote dlopen + get/send work without that private key.
	  Optional hard sign: VEIL_SIP_PRIVATE_ENTITLEMENTS=1 ./build.sh
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
