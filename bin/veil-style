#!/usr/bin/env python3
"""Veil Style — user-friendly theme creator backend for Glyph / Nothing OS.

Commands:
  preview <source> <scheme> <variant> <light|dark>
  apply-named <id>          # nothing | catppuccin-mocha | rose-pine | …
  apply-wall <variant> <light|dark>
  export <name>
  list
  import <pack.toml>
"""
