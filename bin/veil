#!/bin/bash
set -e
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
notify() {  # tell Veil Search the mode changed
  osascript -l JavaScript -e "ObjC.import('Foundation'); \$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately('app.veil.search.mode', '$1', \$(), true)" >/dev/null 2>&1 || true
}
spotlight_key() {  # true: Spotlight owns ⌘Space (symbolic hot key 64); false: Veil Search does
  local f; f=$(mktemp)
  defaults export com.apple.symbolichotkeys "$f" && plutil -replace AppleSymbolicHotKeys.64.enabled -bool "$1" "$f" \
    && defaults import com.apple.symbolichotkeys "$f"
  rm -f "$f"
  /System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u >/dev/null 2>&1 || true
}
menubar() {  # true: auto-hide (Veil's bar stands in); false: macOS menu bar always shown
  osascript -e "tell application \"System Events\" to tell dock preferences to set autohide menu bar to $1" >/dev/null 2>&1 \
    || defaults write NSGlobalDomain _HIHideMenuBar -bool "$1"
}
# SketchyBar and borders run as Veil-owned LaunchAgents written once (`veil agents`): `brew services` rewrites
# its plist on every start/stop, and macOS posts "Background Items Added" for each rewrite. These stay put and
# only run while generated/off is absent (KeepAlive PathState), so off/on is just stop/start.
agent() {  # agent ACTION NAME: kill | kick (start or restart)
  case "$1" in
   kill) launchctl kill SIGTERM "gui/$(id -u)/app.veil.$2" >/dev/null 2>&1 || true ;;
   kick) launchctl kickstart -k "gui/$(id -u)/app.veil.$2" >/dev/null 2>&1 || true ;;
  esac
}
ghostty_reload() {
  osascript -e 'if application "Ghostty" is running then tell application "Ghostty" to perform action "reload_config" on focused terminal of selected tab of front window' >/dev/null 2>&1 || true
}
case "${1:-help}" in
 # quiet mode is kept in a flag file, so theme changes, reloads and reboots respect it (veil-theme reads it)
 quiet)
  touch "$HOME/.config/veil/generated/quiet"
  rift-cli execute config set settings.animate false || true  # Rift may be down; the flag still applies on its next start
  rift-cli execute config set settings.ui.mission_control.fade_enabled false || true
  sketchybar --set cpu update_freq=45 2>/dev/null || true  # only themes that show CPU on the bar poll it
  ;;
 normal)
  rm -f "$HOME/.config/veil/generated/quiet"
  # Reduce Motion (System Settings) still keeps animations off
  if [ "$(defaults read com.apple.universalaccess reduceMotion 2>/dev/null)" != 1 ]; then
   rift-cli execute config set settings.animate true || true
   rift-cli execute config set settings.ui.mission_control.fade_enabled true || true
  fi
  sketchybar --set cpu update_freq=15 2>/dev/null || true
  ;;
 toggle-quiet)
  if [ -f "$HOME/.config/veil/generated/quiet" ]; then "$0" normal; else "$0" quiet; fi ;;
 # Stock look: everything Veil changes steps aside except Rift, which keeps tiling and its keys (bar, borders,
 # overlays, wallpaper, accents, Ghostty, menu bar and ⌘Space go back to macOS); the flag file survives reboots.
 # `veil on [THEME]` brings it back; ⌃⌥⌘V toggles.
 off)
  V="$HOME/.config/veil"; O="$V/backups/original"
  [ -f "$V/generated/off" ] && { echo "Veil is already off (veil on)"; exit 0; }
  theme=$(cat "$V/current" 2>/dev/null || echo night-city)
  mb=$(defaults read NSGlobalDomain _HIHideMenuBar 2>/dev/null || echo 0)
  printf 'theme=%s\nmenubar=%s\n' "$theme" "$mb" > "$V/generated/off"
  agent kill sketchybar; agent kill borders 2>/dev/null || true
  # Veil Search releases ⌘Space / bar / supervised borders (Rift tiling stays)
  notify off
  [ -f "$O/wallpaper.json" ] && [ -x "$V/bin/veil-wallpaper" ] && "$V/bin/veil-baseline" restore-wallpaper --wallpaper-helper "$V/bin/veil-wallpaper" >/dev/null 2>&1 || true
  if [ -f "$O/appearance.json" ]; then
   defaults write -g AppleAccentColor -int "$(jq -r .AppleAccentColor "$O/appearance.json")"
   defaults write -g AppleHighlightColor "$(jq -r .AppleHighlightColor "$O/appearance.json")"
  fi
  defaults delete -g com.apple.sound.beep.sound 2>/dev/null || true
  g="$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"
  [ -f "$O/ghostty.config.ghostty" ] && cp "$O/ghostty.config.ghostty" "$g" && ghostty_reload
  menubar false
  spotlight_key true
  echo "Veil is off. Turn it back on with: veil on (or ⌃⌥⌘V)" ;;
 on)
  V="$HOME/.config/veil"
  [ -f "$V/generated/off" ] || { [ -n "${2:-}" ] && exec veil-theme apply "$2"; echo "Veil is already on"; exit 0; }
  theme=${2:-$(sed -n 's/^theme=//p' "$V/generated/off")}; mb=$(sed -n 's/^menubar=//p' "$V/generated/off")
  rm -f "$V/generated/off"
  spotlight_key false
  notify on   # Veil Search takes ⌘Space back once Spotlight has let go
  [ "$mb" = 1 ] && menubar true
  # Single agent: veil-search supervises borders + Rift; do not revive SketchyBar zoo.
  launchctl kickstart -k "gui/$(id -u)/app.veil.search" 2>/dev/null || true
  # the theme puts back wallpaper, accents, Ghostty and every config
  veil-theme apply "${theme:-night-city}" ;;
 # Unify: only `app.veil.search` at login. Boot out SketchyBar/borders/Rift agents (host owns them).
 agents)
  la="$HOME/Library/LaunchAgents"; mkdir -p "$la" /opt/homebrew/var/log/veil 2>/dev/null || true
  brew services stop sketchybar >/dev/null 2>&1 || true
  brew services stop borders >/dev/null 2>&1 || true
  for name in sketchybar borders; do
   launchctl bootout "gui/$(id -u)/app.veil.$name" 2>/dev/null || true
  done
  # Rift: prefer supervised child of veil-search over its own LaunchAgent.
  rift service uninstall 2>/dev/null || true
  launchctl bootout "gui/$(id -u)/git.acsandmann.rift" 2>/dev/null || true
  # Ensure the one host agent exists.
  search="$la/app.veil.search.plist"
  if [ ! -f "$search" ]; then
   cat > "$search" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
	<key>Label</key><string>app.veil.search</string>
	<key>ProcessType</key><string>Interactive</string>
	<key>ProgramArguments</key>
	<array>
		<string>$HOME/Applications/Veil Search.app/Contents/MacOS/veil-search</string>
		<string>--background</string>
	</array>
	<key>RunAtLoad</key><true/>
</dict>
</plist>
PLIST
  fi
  launchctl bootstrap "gui/$(id -u)" "$search" 2>/dev/null || true
  [ -f "$HOME/.config/veil/generated/off" ] || launchctl kickstart -k "gui/$(id -u)/app.veil.search" 2>/dev/null || true
  echo "Veil agents: app.veil.search only (borders+Rift supervised in-process; SketchyBar retired)" ;;
 toggle) if [ -f "$HOME/.config/veil/generated/off" ]; then "$0" on; else "$0" off; fi ;;
 pause) rift-cli execute space toggle-activated ;;
 reload) rift-cli execute config reload; pgrep -xq sketchybar && sketchybar --reload || true ;;
 # recover: restart the single host (respawns borders + Rift children)
 recover)
  "$0" agents
  launchctl kickstart -k "gui/$(id -u)/app.veil.search" 2>/dev/null || true ;;
 quit)
  # Stop supervised Rift via host notification; fall back to pkill.
  osascript -l JavaScript -e "ObjC.import('Foundation'); \$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately('app.veil.host', 'quit-rift', \$(), true)" >/dev/null 2>&1 || true
  pkill -x rift 2>/dev/null || true ;;
 keys)
  sed -n '/^\[keys\]/,/^\[binding_modes/p' "$HOME/.config/rift/config.toml" | grep '^"' \
    | sed -E 's/^"([^"]+)" = (.*)$/\1\t\2/; s/Alt/⌥/g; s/Shift/⇧/g; s/Ctrl/⌃/g; s/ \+ //g' | column -t -s $'\t' ;;
 overview)
  # Visible product surface: Veil Search overview grid (exclusive surface) + Rift mission control behind it.
  if ! pgrep -xq veil-search; then
    open -a "$HOME/Applications/Veil Search.app" || true
    sleep 0.55
  fi
  # Show Search FIRST so dismiss→overview races and mission-control cannot swallow the panel.
  osascript -l JavaScript -e "ObjC.import('Foundation'); \$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately('app.veil.search.show', 'overview', \$(), true)" >/dev/null 2>&1 || true
  rift-cli execute mission-control show-all >/dev/null 2>&1 || true
  # Re-assert Search on top after mission-control (statusBar panel + second notify).
  sleep 0.08
  osascript -l JavaScript -e "ObjC.import('Foundation'); \$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately('app.veil.search.show', 'overview', \$(), true)" >/dev/null 2>&1 || true
  ;;
 dismiss-popups)
  sketchybar --set music popup.drawing=off --set clock popup.drawing=off --set keys popup.drawing=off --set city popup.drawing=off 2>/dev/null || true
  osascript -l JavaScript -e "ObjC.import('Foundation'); \$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately('app.veil.panel', 'dismiss', \$(), true)" >/dev/null 2>&1 || true
  rift-cli execute mission-control dismiss >/dev/null 2>&1 || true
  # Hide Veil Search. Object is epoch-ms so a hide posted BEFORE a newer show is ignored (dismiss→overview race).
  _veil_hide_ts=$(/usr/bin/python3 -c 'import time; print(int(time.time()*1000))' 2>/dev/null || date +%s000)
  osascript -l JavaScript -e "ObjC.import('Foundation'); \$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately('app.veil.search.hide', '$_veil_hide_ts', \$(), true)" >/dev/null 2>&1 || true
  ;;
 themes)
  # Reliable gallery opener when Cursor steals ⌘T (also: ⌃⌥T global hotkey, Search → theme).
  if ! pgrep -xq veil-search; then
    open -a "$HOME/Applications/Veil Search.app" || true
    sleep 0.45
  fi
  osascript -l JavaScript -e "ObjC.import('Foundation'); \$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately('app.veil.search.show', 'theme', \$(), true)" >/dev/null 2>&1 || true
  ;;
 music-popup)
  # Animated Veil panel by default; SketchyBar popup when sketchybar-popups is enabled.
  if [ -f "$HOME/.config/veil/generated/features/enable-sketchybar-popups" ] \
     || [ -f "$HOME/.config/veil/generated/features/disable-animated-panels" ]; then
    exec "$HOME/.config/sketchybar/plugins/veil.sh" music mouse.clicked
  fi
  osascript -l JavaScript -e "ObjC.import('Foundation'); \$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately('app.veil.panel', 'music', \$(), true)" >/dev/null 2>&1 || true
  ;;
 panel)
  # Animated control/music/keys panels hosted by Veil Search.
  kind=${2:-control}
  osascript -l JavaScript -e "ObjC.import('Foundation'); \$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately('app.veil.panel', '$kind', \$(), true)" >/dev/null 2>&1 || true
  ;;
 saver-preview)
  # Safe in-process preview — never launches ScreenSaverEngine / never locks.
  exec "$HOME/.config/veil/tools/saver-preview/run.sh" "${2:-}"
  ;;
 saver-companion)
  bin="$HOME/.config/veil/bin/veil-saver-companion"
  [ -x "$bin" ] || "$HOME/.config/veil/tools/saver-companion/build.sh" "$bin"
  if [ "${2:-}" = "--once" ] || [ "${2:-}" = "once" ]; then exec "$bin" --once; fi
  echo "usage: veil saver-companion --once | veil feature enable saver-companion"
  ;;
 ws-chrome)
  bin="$HOME/.config/veil/bin/veil-ws-chrome"
  [ -x "$bin" ] || "$HOME/.config/veil/tools/ws-chrome/build.sh" "$bin"
  exec "$bin" "${2:-status}"
  ;;
 launch)
  if pgrep -xq veil-search; then
   osascript -l JavaScript -e "ObjC.import('Foundation'); \$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately('app.veil.search.show', \$(), \$(), true)"
  else
   open -a "$HOME/Applications/Veil Search.app"
  fi
  ;;
 # new Ghostty window (open -a only focuses a running Ghostty); first use asks once for Automation permission
 term)
  osascript -e 'tell application "Ghostty"' -e 'if it is running then new window' -e 'activate' -e 'end tell' >/dev/null ;;
 # btop needs ~80 columns: open it tiled, then fill the tiling area once Rift has placed it (⌥F restores)
 btop)
  open -na Ghostty.app --args --title=VEIL//SYSTEM --quit-after-last-window-closed=true --command=btop
  for _ in $(seq 30); do
   id=$(rift-cli query workspaces 2>/dev/null | jq -c 'first(.[] | select(.is_active) | .windows[] | select(.title == "VEIL//SYSTEM") | .id) // empty')
   [ -n "$id" ] && { rift-cli execute window focus --window-id "$id" >/dev/null; rift-cli execute window toggle-fullscreen-within-gaps >/dev/null; break; }
   sleep 0.1
  done ;;
 status)
  rift-cli query workspaces
  echo "--- host ---"
  pgrep -lf 'veil-search|borders|rift|sketchybar' || true
  launchctl list | grep -E 'veil|rift' || true
  pgrep -xq sketchybar && sketchybar --query bar || echo "sketchybar: retired (veil-bar)"
  ;;
 selftest)
  [ -f "$HOME/.config/veil/generated/off" ] && { echo "Veil is off (stock macOS); nothing to check. Turn it on with: veil on"; exit 0; }
  set +e; fail=0
  check() { if eval "$2" >/dev/null 2>&1; then echo "PASS  $1"; else echo "FAIL  $1"; fail=1; fi; }
  VEIL_BAR=1; [ -f "$HOME/.config/veil/generated/features/disable-veil-bar" ] && VEIL_BAR=0
  check "rift running" "pgrep -x rift"
  check "borders running" "pgrep -x borders"
  check "launcher running" "pgrep -xq veil-search"
  if [ "$VEIL_BAR" = 1 ]; then
    check "sketchybar stopped (unified bar)" "! pgrep -x sketchybar"
    check "in-process bar (veil-bar default)" "true"
  else
    check "sketchybar running (veil-bar disabled)" "pgrep -x sketchybar"
  fi
  check "app.veil.search starts at login" "launchctl print gui/$(id -u)/app.veil.search"
  check "sketchybar agent retired" "! launchctl print gui/$(id -u)/app.veil.sketchybar >/dev/null 2>&1"
  check "borders agent retired" "! launchctl print gui/$(id -u)/app.veil.borders >/dev/null 2>&1"
  check "rift agent retired" "! launchctl print gui/$(id -u)/git.acsandmann.rift >/dev/null 2>&1"
  check "rift answers queries" "perl -e 'alarm 5; exec @ARGV' rift-cli query workspaces"
  check "theme files match templates" "veil-theme status | grep -q 'all files match'"
  # Spotlight keeps ⌘Space unless its shortcut (symbolic hot key 64) is off; then Veil Search can't open with it
  check "Spotlight has released ⌘Space" "[ \"\$(defaults export com.apple.symbolichotkeys - | plutil -extract AppleSymbolicHotKeys.64.enabled raw -)\" = false ]"
  check "veil-thumbs helper installed" "[ -x \"$HOME/Applications/Veil Search.app/Contents/MacOS/veil-thumbs\" ]"
  check "launcher has no ScreenCaptureKit" "! otool -L \"$HOME/Applications/Veil Search.app/Contents/MacOS/veil-search\" | grep -q ScreenCaptureKit"
  check "music snapshot returns JSON" "\"$HOME/.config/sketchybar/plugins/veil.sh\" music snapshot | jq -e 'type == \"object\"' >/dev/null"
  check "ScreenSaverEngine not running" "! pgrep -x ScreenSaverEngine"
  exit $fail
  ;;
 # launcher menu entry: run the selftest and show the result as a notification
 selftest-notify)
  out=$("$0" selftest 2>&1) || true; n=$(grep -c '^FAIL' <<<"$out" || true)
  if [ "$n" = 0 ]; then msg="All checks passed"; else msg="$n failed: $(grep '^FAIL' <<<"$out" | cut -c7- | paste -sd, -)"; fi
  osascript -e "display notification \"$msg\" with title \"Veil self-test\"" ;;
 feature)
  # Default-on: disable via generated/features/disable-<name>
  # Default-off (SIP-gated / fallbacks): enable via generated/features/enable-<name>
  V="$HOME/.config/veil"; F="$V/generated/features"; mkdir -p "$F"
  # veil-bar is default-on (thin host strip). Migrate phase-1 enable flag away.
  on_by_default='music-popup clock-calendar cider-bridge screensaver-sync animated-panels overview-live-thumbs veil-bar'
  off_by_default='sip-nowplaying sketchybar-popups force-reduce-motion saver-companion ws-chrome'
  known="$on_by_default $off_by_default"
  is_known() { echo " $known " | grep -q " $1 "; }
  is_opt_in() { echo " $off_by_default " | grep -q " $1 "; }
  rm -f "$F/enable-veil-bar"
  case "${2:-}" in
   list|"")
    echo "Veil features (veil feature enable|disable NAME)"
    for name in $on_by_default; do
      if [ -f "$F/disable-$name" ]; then state=off; else state=on; fi
      printf '  %-20s %s' "$name" "$state"
      [ "$name" = veil-bar ] && printf '  (default thin host strip; disable → SketchyBar)'
      printf '\n'
    done
    for name in $off_by_default; do
      if [ -f "$F/enable-$name" ]; then state=on; else state=off; fi
      printf '  %-20s %s  (opt-in' "$name" "$state"
      [ "$name" = sip-nowplaying ] && printf '; SIP-gated — see tools/sip-nowplaying/README.md'
      [ "$name" = sketchybar-popups ] && printf '; SketchyBar popup menus (skips animated panels)'
      [ "$name" = force-reduce-motion ] && printf '; panels use still-path without system Reduce Motion'
      [ "$name" = saver-companion ] && printf '; VEI-40 idle theme companion — never ScreenSaverEngine'
      [ "$name" = ws-chrome ] && printf '; VEI-41 thicker borders / window-server chrome'
      printf ')\n'
    done ;;
   disable)
    name=${3:?feature name}; is_known "$name" || { echo "unknown feature: $name (want: $known)"; exit 1; }
    if is_opt_in "$name"; then
      rm -f "$F/enable-$name"
      case "$name" in
       sketchybar-popups)
        sketchybar --bar hidden=off 2>/dev/null || true
        osascript -l JavaScript -e "ObjC.import('Foundation'); \$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately('app.veil.search.theme', \$(), \$(), true)" >/dev/null 2>&1 || true
        ;;
       saver-companion)
        launchctl bootout "gui/$(id -u)/app.veil.saver-companion" 2>/dev/null || true
        pkill -x veil-saver-companion 2>/dev/null || true
        ;;
       ws-chrome)
        [ -x "$V/bin/veil-ws-chrome" ] && "$V/bin/veil-ws-chrome" disable || true
        ;;
      esac
    else
      touch "$F/disable-$name"
      case "$name" in
       music-popup|clock-calendar) veil-theme apply "$(cat "$V/current")" ;;
       screensaver-sync) python3 "$V/screensaver/sync.py" "$V" --remove 2>/dev/null || true ;;
       veil-bar)
        launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/app.veil.sketchybar.plist" 2>/dev/null || true
        agent kick sketchybar
        osascript -l JavaScript -e "ObjC.import('Foundation'); \$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately('app.veil.search.theme', \$(), \$(), true)" >/dev/null 2>&1 || true
        ;;
      esac
    fi
    echo "disabled $name" ;;
   enable)
    name=${3:?feature name}; is_known "$name" || { echo "unknown feature: $name (want: $known)"; exit 1; }
    if is_opt_in "$name"; then
      touch "$F/enable-$name"
      if [ "$name" = sip-nowplaying ]; then
        rm -f "$F/.sip-nowplaying-amfi-blocked"
        if [ ! -x "$V/bin/veil-nowplaying-sip" ]; then
          "$V/tools/sip-nowplaying/build.sh" "$V/bin/veil-nowplaying-sip" || true
        fi
        if /usr/bin/csrutil status 2>/dev/null | /usr/bin/grep -qi 'enabled'; then
          echo "enabled sip-nowplaying (flag on). SIP is still enabled — helper stays fallback until SIP is off after wake; music dropdown keeps media-control."
        else
          if "$V/bin/veil-nowplaying-sip" status >/dev/null 2>&1; then
            echo "enabled sip-nowplaying (SIP disabled — helper preferred when it returns data)"
          else
            printf 'amfi_sigkill on enable ts=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$F/.sip-nowplaying-amfi-blocked" 2>/dev/null || true
            echo "enabled sip-nowplaying (flag on). SIP is off but AMFI still kills the helper (exit 137) — music keeps media-control. Needs AMFI boot-arg with explicit consent; see docs/sip-preflight.md"
          fi
        fi
      elif [ "$name" = sketchybar-popups ]; then
        sketchybar --bar hidden=off 2>/dev/null || true
        echo "enabled sketchybar-popups (SketchyBar strip + popups; animated Veil panels step aside)"
      elif [ "$name" = saver-companion ]; then
        "$V/tools/saver-companion/build.sh" "$V/bin/veil-saver-companion" || true
        # Optional LaunchAgent — idle watch; never SSE.
        la="$HOME/Library/LaunchAgents/app.veil.saver-companion.plist"
        cat > "$la" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>app.veil.saver-companion</string>
  <key>ProgramArguments</key><array>
    <string>$V/bin/veil-saver-companion</string>
    <string>--idle</string><string>180</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
</dict></plist>
PLIST
        launchctl bootout "gui/$(id -u)/app.veil.saver-companion" 2>/dev/null || true
        launchctl bootstrap "gui/$(id -u)" "$la" 2>/dev/null || true
        launchctl kickstart -k "gui/$(id -u)/app.veil.saver-companion" 2>/dev/null || true
        echo "enabled saver-companion (idle 180s theme overlay; click/key dismiss; no ScreenSaverEngine)"
      elif [ "$name" = ws-chrome ]; then
        "$V/tools/ws-chrome/build.sh" "$V/bin/veil-ws-chrome" || true
        "$V/bin/veil-ws-chrome" enable
        echo "enabled ws-chrome (borders width=8; disable restores backup)"
      fi
    else
      rm -f "$F/disable-$name"
      case "$name" in
       music-popup|clock-calendar|screensaver-sync) veil-theme apply "$(cat "$V/current")" ;;
       animated-panels|veil-bar)
        [ "$name" = veil-bar ] && { launchctl bootout "gui/$(id -u)/app.veil.sketchybar" 2>/dev/null || true; pkill -x sketchybar 2>/dev/null || true; }
        osascript -l JavaScript -e "ObjC.import('Foundation'); \$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately('app.veil.search.theme', \$(), \$(), true)" >/dev/null 2>&1 || true
        ;;
      esac
      echo "enabled $name"
    fi ;;
   *) echo "usage: veil feature [list|enable NAME|disable NAME]"; exit 1 ;;
  esac ;;
  rice)
  # VEI-57 Nothing Glyph-field chrome (wall/Dock/desktop icons) — see tools/rice/README.md
  exec "$HOME/.config/veil/bin/veil-rice" "${@:2}" ;;
  *) printf '%s\n' 'Veil: veil off | on [THEME] | toggle | quiet | normal | toggle-quiet | feature | pause | reload | recover | quit | keys | overview | themes | music-popup | panel | dismiss-popups | saver-preview | saver-companion | ws-chrome | rice | launch | term | btop | status | selftest' ;;
esac
