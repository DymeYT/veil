{
  "workbench.colorCustomizations": {
    "[*Dark*]": {
      "editor.background": "#090d17",
      "editor.foreground": "#d9f4ff",
      "editor.selectionBackground": "#26385a",
      "editor.lineHighlightBackground": "#0e1524",
      "editorCursor.foreground": "#fcee09",
      "editorLineNumber.foreground": "#334563",
      "editorLineNumber.activeForeground": "#00e5ff",
      "sideBar.background": "#070a12",
      "activityBar.background": "#070a12",
      "activityBar.foreground": "#00e5ff",
      "activityBarBadge.background": "#ff4fbc",
      "titleBar.activeBackground": "#070a12",
      "statusBar.background": "#070a12",
      "statusBar.foreground": "#8794ad",
      "panel.background": "#090d17",
      "terminal.background": "#090d17",
      "editorGroupHeader.tabsBackground": "#070a12",
      "tab.activeBackground": "#090d17",
      "tab.activeBorderTop": "#00e5ff",
      "tab.inactiveBackground": "#070a12",
      "focusBorder": "#00e5ff",
      "button.background": "#ff4fbc",
      "list.activeSelectionBackground": "#26385a",
      "list.highlightForeground": "#ff4fbc",
      "textLink.foreground": "#00e5ff"
    }
  },
  "editor.fontFamily": "@@term_font@@, monospace",
  "terminal.integrated.fontFamily": "@@term_font@@",
  "editor.lineHeight": @@cursor_line_height@@,
  "editor.cursorStyle": "@@editor_cursor_style@@",
  "editor.cursorBlinking": "solid",
  "editor.minimap.enabled": @@cursor_minimap@@,
  "editor.renderLineHighlight": "@@cursor_highlight@@",
  "workbench.activityBar.location": "@@cursor_activity@@",
  "workbench.editor.tabSizing": "@@cursor_tabs@@",
  "workbench.tree.indent": @@cursor_indent@@,
  "workbench.sideBar.location": "@@cursor_sidebar@@",
  "workbench.editor.showTabs": "@@cursor_show_tabs@@",
  "breadcrumbs.enabled": @@cursor_breadcrumbs@@,
  "editor.stickyScroll.enabled": @@cursor_sticky@@,
  "editor.lineNumbers": "@@cursor_numbers@@",
  "editor.wordWrap": "@@cursor_wrap@@",
  "editor.renderWhitespace": "@@cursor_whitespace@@",
  "editor.minimap.side": "@@cursor_minimap_side@@"
}
